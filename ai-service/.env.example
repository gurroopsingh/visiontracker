# AI Service Configuration
# Copy to .env and fill in your values

# Port the FastAPI service listens on
AI_SERVICE_PORT=8000

# CLIP model to use (kept explicit and changeable as required)
CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# Similarity threshold for a "match" (0.0 – 1.0)
# Must match AI_MATCH_THRESHOLD in backend/.env
AI_MATCH_THRESHOLD=0.75

# Base URL of the Node.js backend (used for callbacks)
BACKEND_URL=http://localhost:5000

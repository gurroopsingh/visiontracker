# Backend Environment Variables
# Copy this file to .env and fill in your values
# Never commit .env to Git

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/visiontracker
# Or use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/visiontracker

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_replace_with_long_random_string
JWT_EXPIRES_IN=7d

# ── CORS ───────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Admin Diagnostics Page ─────────────────────────────────────────────────────
# Access the /admin page with: GET /admin?secret=<ADMIN_SECRET>
# Leave empty to disable protection (development only).
ADMIN_SECRET=your_admin_secret_here

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
# Options: error | warn | info | debug

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379  (alternative — Docker style)

# ── AI Microservice (FastAPI/CLIP) ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Similarity threshold (0.0–1.0). Must match ai-service/.env
AI_MATCH_THRESHOLD=0.75

# ── File Uploads ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

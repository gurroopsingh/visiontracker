{
  "info": {
    "_postman_id": "b3e0c0c5-3b9c-4b3d-9d45-6f8d3f1a9b2c",
    "name": "VisionTracker Phase 2",
    "description": "API collection for VisionTracker - Campus Lost & Found System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@chitkara.edu.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success) {",
                  "    pm.environment.set(\"jwt_token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@chitkara.edu.in\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Items",
      "item": [
        {
          "name": "Get All Items (with filters)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items?page=1&limit=10&sort=-createdAt&type=lost",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "sort", "value": "-createdAt" },
                { "key": "type", "value": "lost", "description": "lost | found" },
                { "key": "category", "value": "Electronics", "disabled": true },
                { "key": "status", "value": "active", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get My Items",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/items/my",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "my"]
            }
          }
        },
        {
          "name": "Get Single Item",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/items/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", ":id"],
              "variable": [
                { "key": "id", "value": "REPLACE_WITH_ITEM_ID" }
              ]
            }
          }
        },
        {
          "name": "Report Lost Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Lost iPhone 13", "type": "text" },
                { "key": "description", "value": "Black case, cracked screen", "type": "text" },
                { "key": "category", "value": "Electronics", "type": "text" },
                { "key": "location", "value": "Library", "type": "text" },
                { "key": "date", "value": "2026-10-01", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/items/lost",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "lost"]
            }
          }
        },
        {
          "name": "Report Found Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Found AirPods", "type": "text" },
                { "key": "description", "value": "White case, found on bench", "type": "text" },
                { "key": "category", "value": "Electronics", "type": "text" },
                { "key": "location", "value": "Park", "type": "text" },
                { "key": "date", "value": "2026-10-02", "type": "text" },
                { "key": "image", "type": "file", "src": [], "description": "Attach a test image" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/items/found",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items", "found"]
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ]
}
